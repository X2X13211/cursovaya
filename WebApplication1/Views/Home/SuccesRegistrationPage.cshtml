@{
    ViewData["Title"] = "Заявление успешно подано";
    var ticketNumber = Guid.NewGuid().ToString("N")[..8].ToUpper();
}

<div class="flex min-h-[calc(100vh-16rem)] items-center justify-center py-12 px-4">
    <div class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
        
            <!-- Иконка статуса -->
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full border border-emerald-100 bg-emerald-50 text-emerald-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-8 w-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
            </div>

        <!-- Заголовок -->
        <div class="mb-8 border-b border-slate-100 pb-6 text-center">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Заявление принято!</h1>
            <p class="mt-2 text-sm text-slate-500">
                Ваши данные успешно зарегистрированы в системе. Ожидайте подтверждение на электронную почту.
            </p>
        </div>

        <!-- Детали заявки -->
        <div class="space-y-4">
            <h3 class="text-center text-xs font-semibold tracking-wider text-slate-400 uppercase">
                Информация о заявке
            </h3>

            <div class="space-y-3 rounded-lg border border-slate-200 bg-slate-50/70 p-4">
                <div class="flex items-center justify-between text-sm">
                    <span class="text-slate-500">Статус</span>
                    
                    <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">
                        Данные на проверке
                    </span>
                    @*<span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-emerald-600/20 ring-inset">
                        Ожидает распределения показывем после подтверждения данных
                    </span>*@
                </div>

                <div class="flex items-center justify-between border-t border-slate-200/60 pt-3 text-sm">
                    <span class="text-slate-500">Номер обращения</span>
                    <span class="font-mono font-semibold text-slate-900">
                        #@ticketNumber
                    </span>
                </div>
            </div>
        </div>
        
        <div class="pt-6">
            <a asp-controller="Home" asp-action="Index" 
               class="inline-flex w-full items-center justify-center rounded-lg bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500">
                Вернуться на главную
            </a>
        </div>

        <!-- Футер карточки -->
        <div class="mt-6 border-t border-slate-100 pt-6 text-center">
            <p class="text-xs text-slate-400">
                При возникновении вопросов обратитесь в комендатуру своего корпуса
            </p>
        </div>

    </div>
</div>