@{
    ViewData["Title"] = "Панель управления общежитием";
}

<!-- Гарантированная подгрузка всех утилит Tailwind -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="w-full max-w-7xl mx-auto space-y-6 py-6 px-4">
    
    <!-- 1. Верхняя шапка дашборда -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Учёт жильцов и распределение</h1>
        </div>

        <a asp-controller="Home" asp-action="Index" title="Выйти на главную"
           class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
            </svg>
            <span>Выход</span>
        </a>
    </div>

    <!-- 2. Три карточки статистики в жесткой сетке -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Карточка 1: Жильцы и места -->
        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <div>
                    <p class="text-sm font-medium text-slate-500">Занято мест</p>
                </div>
            </div>
            <div class="text-right whitespace-nowrap">
                <span class="text-2xl font-bold text-slate-900"></span>
                <span class="text-sm font-medium text-slate-400">/ 450</span>
            </div>
        </div>

        <!-- Карточка 2: Оплата и задолженности -->
        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <div>
                    <p class="text-sm font-medium text-slate-500">Оплат</p>
                </div>
            </div>
            <div class="text-right whitespace-nowrap">
                <span class="text-2xl font-bold text-slate-900">1.24 МЛН</span>
            </div>
        </div>

        <!-- Карточка 3: Заявки в работе -->
        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <div>
                    <p class="text-sm font-medium text-slate-500">Заявки на ремонт</p>
                </div>
            </div>
            <div class="text-right whitespace-nowrap">
                <span class="text-2xl font-bold text-slate-900">18</span>
            </div>
        </div>

    </div>

    <!-- 3. Панель поиска и фильтрации -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <div class="flex items-center w-full sm:max-w-md rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="text-slate-400 shrink-0 mr-2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
            <input type="text" placeholder="Поиск по ФИО, группе, комнате..."
                   class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none" />
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <select class="rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 shadow-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none">
                <option value="all">Все корпуса</option>
                <option value="1">Корпус №1</option>
                <option value="2">Корпус №2</option>
                <option value="3">Корпус №3</option>
            </select>

            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 whitespace-nowrap">
                Заселить жильца
            </a>
        </div>
    </div>

    <!-- 4. Основная таблица с динамическим выводом из модели -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-400 whitespace-nowrap">
                        <th class="py-3.5 pl-6 pr-4">Жилец</th>
                        <th class="px-4 py-3.5">Группа</th>
                        <th class="px-4 py-3.5">Паспорт</th>
                        <th class="px-4 py-3.5">Статус</th>
                        <th class="px-4 py-3.5">Срок</th>
                        <th class="px-4 py-3.5">Размещение</th>
                        <th class="px-4 py-3.5">Баланс</th>
                        <th class="py-3.5 pl-4 pr-6 text-right">Действия</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-sm">

                   
                        <tr>
                            <td colspan="8" class="py-8 text-center text-slate-400 text-sm">
                                База данных пока не содержит записей или контроллер не передал модель.
                            </td>
                        </tr>
                    
                    
                </tbody>
            </table>
        </div>

        <!-- 5. Панель пагинации (как на вашем скриншоте) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200 bg-slate-50/50 px-6 py-4">
            
            <!-- Выпадающий список выбора количества элементов -->
            <div class="flex items-center gap-3 text-sm text-slate-500">
                <div class="relative">
                    <select class="appearance-none rounded-xl border border-slate-200 bg-white py-2 pl-3.5 pr-8 text-xs font-medium text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
                        <option value="10">10</option>
                        <option value="30" selected>30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>
                <span>Элементов на страницу</span>
            </div>

            <!-- Кнопки переключения страниц (как на вашем скриншоте) -->
            <div class="flex items-center gap-1">
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-400 shadow-sm transition hover:bg-slate-50 hover:text-slate-700 disabled:opacity-50">
                    ← Назад
                </button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-indigo-600 bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white shadow-sm">
                    1
                </button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                    2
                </button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                    3
                </button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                    4
                </button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                    5
                </button>
                <span class="px-1 text-slate-400 text-xs">...</span>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                    15
                </button>
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                    Вперед →
                </button>
            </div>

        </div>

    </div>

</div>